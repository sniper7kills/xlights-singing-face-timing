{
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run format)",
      "Bash(npm test)",
      "Bash(npm run test:e2e)",
      "Bash(npx playwright install chromium)",
      "Bash(node scripts/build-dictionary.mjs)",
      "Bash(python3 docs/specs/render-spec.py)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x \"${CLAUDE_PROJECT_DIR}/node_modules/.bin/prettier\" ] || exit 0; \"${CLAUDE_PROJECT_DIR}/node_modules/.bin/prettier\" --write --ignore-unknown $CLAUDE_FILE_PATHS"
          }
        ]
      }
    ]
  }
}
